# Supabase (create project at supabase.com, run supabase/schema.sql)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Frontend Supabase (anon key — Auth → Google provider + redirect URL /auth/callback)
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key

# Admin credentials (set strong values in production)
ADMIN_PASSWORD=changeme
SUPER_ADMIN_PASSWORD=changeme-super
ADMIN_SECRET=changeme-long-random-string

# Optional: protect cron endpoint in production
CRON_SECRET=
